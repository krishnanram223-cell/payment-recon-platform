{
  "name": "payment-recon-platform",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && pip install -e .",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Kafka UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
